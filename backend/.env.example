# Copia este archivo como .env y ajusta los valores antes de iniciar el servidor.

APP_NAME="Transacciones API"
APP_VERSION="1.0.0"
APP_ENV=development

# Orígenes CORS permitidos. Separa múltiples orígenes con coma.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Tamaño máximo permitido por archivo en MB.
MAX_UPLOAD_FILE_SIZE_MB=10
